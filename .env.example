# ClawMind — Environment Configuration

# Network
ZERO_G_NETWORK=mainnet

# Compute
ZERO_G_COMPUTE_ENDPOINT=https://router-api.0g.ai/v1/chat/completions
ZERO_G_COMPUTE_API_KEY=your_api_key
ZERO_G_COMPUTE_MODEL=deepseek/deepseek-chat-v3-0324

# Storage
ZERO_G_STORAGE_ENABLED=true
ZERO_G_STORAGE_PRIVATE_KEY=your_private_key

# Analysis Registry
ZERO_G_ANALYSIS_REGISTRY_ADDRESS=<current_registry_address>
ZERO_G_ALLOW_LEGACY_REGISTRY_WRITES=false

# Memory
ZERO_G_MEMORY_INDEX_URI=
