# ═══════════════════════════════════════════════════════════════════════
# ClawMind — Environment Configuration
# ═══════════════════════════════════════════════════════════════════════
#
# 🚨 CRITICAL FOR HACKATHON: Without these 4 variables set correctly,
#    NO on-chain transactions will appear on 0G Explorer, and your
#    project WILL be disqualified for lack of real 0G integration.
#
#    Copy this file to .env and fill in the real values:
#      cp .env.example .env
# ═══════════════════════════════════════════════════════════════════════

# ─── Network (CRITICAL — must be "mainnet" for hackathon) ────────────
# Your contract is deployed on 0G MAINNET. If this is "testnet", the
# code will connect to the testnet RPC and your mainnet contract will
# never receive any transactions.
ZERO_G_NETWORK=mainnet

# ─── 0G Compute / 0G Router ──────────────────────────────────────────
# Mainnet endpoint for agent inference via 0G Router API
ZERO_G_COMPUTE_ENDPOINT=https://router-api.0g.ai/v1/chat/completions
ZERO_G_COMPUTE_API_KEY=your_0g_mainnet_router_api_key
# Available mainnet models (as of 2025-05):
#   deepseek/deepseek-chat-v3-0324  — best for reasoning/analysis
#   qwen3.6-plus                    — good general-purpose model
#   zai-org/GLM-5-FP8              — Z.ai's own model
#   zai-org/GLM-5.1-FP8            — Z.ai's latest model
# qwen/qwen-2.5-7b-instruct is TESTNET ONLY — do NOT use on mainnet!
ZERO_G_COMPUTE_MODEL=deepseek/deepseek-chat-v3-0324

# ─── 0G Storage (CRITICAL — needs real private key with 0G tokens) ──
# Must be "true" for reports and memory to be stored on 0G Storage.
# If false, everything falls back to LOCAL_FALLBACK (not visible on-chain).
ZERO_G_STORAGE_ENABLED=true

# Private key of a wallet that holds 0G tokens on mainnet for gas.
# This is used for BOTH 0G Storage uploads AND on-chain contract writes.
# 🚨 NEVER commit this to git — make sure .env is in .gitignore!
ZERO_G_STORAGE_PRIVATE_KEY=your_mainnet_wallet_private_key

# Override only if you need custom RPC endpoints for the selected network:
# ZERO_G_STORAGE_EVM_RPC=https://evmrpc.0g.ai
# ZERO_G_STORAGE_INDEXER_RPC=https://indexer-storage-turbo.0g.ai

# ─── 0G On-Chain Analysis Registry ───────────────────────────────────
# Address of the deployed AnalysisRegistry.sol contract on 0G mainnet.
# Use the signed registry version for EIP-712 operator authentication.
# When set alongside a valid ZERO_G_STORAGE_PRIVATE_KEY, each completed
# analysis will be anchored on-chain with a real transaction.
ZERO_G_ANALYSIS_REGISTRY_ADDRESS=0x24bAAC6720ae5B01A1CC90eCC1C15AFcb903E121
ZERO_G_ANALYSIS_REGISTRY_DEPLOY_BLOCK=34500039

# Temporary escape hatch for the old unauthenticated registry.
# Keep false in production; deploy the signed registry instead.
ZERO_G_ALLOW_LEGACY_REGISTRY_WRITES=false

# ─── Memory Bootstrap ────────────────────────────────────────────────
# Optional: forces ClawMind to hydrate memory from a known 0G memory
# index. Paste the Memory Index URI from a previous successful run.
ZERO_G_MEMORY_INDEX_URI=

# ═══════════════════════════════════════════════════════════════════════
# QUICK CHECKLIST — verify before demo:
#   [ ] ZERO_G_NETWORK=mainnet
#   [ ] ZERO_G_STORAGE_ENABLED=true
#   [ ] ZERO_G_STORAGE_PRIVATE_KEY=<real key with 0G tokens>
#   [ ] ZERO_G_ANALYSIS_REGISTRY_ADDRESS=0x24bAAC6720ae5B01A1CC90eCC1C15AFcb903E121
#   [ ] ZERO_G_ANALYSIS_REGISTRY_DEPLOY_BLOCK=34500039
#   [ ] ZERO_G_ALLOW_LEGACY_REGISTRY_WRITES=false
#   [ ] Wallet has 0G tokens for gas (check at https://chainscan.0g.ai)
#   [ ] Visit /api/debug to verify full configuration status
# ═══════════════════════════════════════════════════════════════════════
